{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://720.hackhive/contract/obd.schema.json",
  "title": "720 obd message (~1 Hz, server -> UI)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "sent_at", "channels"],
  "properties": {
    "schema_version": { "const": "1.6" },
    "sent_at": { "type": "number", "description": "unix seconds" },
    "source_label": {
      "enum": ["simulated", "real_replay", "real_replay_injected", "real_upload", "real_upload_injected"],
      "description": "1.6 (optional): as state.source_label"
    },
    "channels": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["t", "v", "unit", "source"],
        "properties": {
          "t": { "type": "array", "items": { "type": "number" }, "description": "stream time, s" },
          "v": { "type": "array", "items": { "type": "number" } },
          "unit": { "type": "string" },
          "source": { "enum": ["real_carobd", "real_upload", "simulator"], "description": "1.6 adds real_upload: a user-uploaded carOBD-format log, unverified" },
          "calibration": {
            "enum": ["real_calibrated", "sim_only"],
            "description": "1.5 (optional): for simulator channels, real_calibrated = constants measured on carOBD calibration files, sim_only = no carOBD counterpart"
          }
        }
      }
    }
  }
}
