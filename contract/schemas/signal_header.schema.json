{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://720.hackhive/contract/signal_header.schema.json",
  "title": "720 signal frame header (binary channel, server -> UI); see signal_frame.md",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "sent_at", "channel", "kind", "t0", "sample_rate_hz", "n_samples", "dtype"],
  "properties": {
    "schema_version": { "const": "1.6" },
    "sent_at": { "type": "number", "description": "unix seconds" },
    "channel": { "type": "string", "minLength": 1, "description": "e.g. mic, accel, crank_speed, mic_stft, accel_stft" },
    "kind": { "enum": ["waveform", "spectrogram"] },
    "t0": { "type": "number", "description": "stream time of the first sample or column, s" },
    "sample_rate_hz": { "type": "number", "exclusiveMinimum": 0, "description": "after server downsampling; column rate for spectrograms" },
    "n_samples": { "type": "integer", "minimum": 0, "description": "number of float32 values in the payload" },
    "dtype": { "const": "float32" },
    "n_bins": { "type": "integer", "minimum": 1 },
    "n_frames": { "type": "integer", "minimum": 1 },
    "f_max_hz": { "type": "number", "exclusiveMinimum": 0 }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "spectrogram" } } },
      "then": { "required": ["n_bins", "n_frames", "f_max_hz"] }
    }
  ]
}
