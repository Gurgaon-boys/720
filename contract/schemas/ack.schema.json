{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://720.hackhive/contract/ack.schema.json",
  "title": "720 ack message (UI -> rule layer, on click)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "type", "alarm_id", "operator", "sent_at"],
  "properties": {
    "schema_version": { "const": "1.6" },
    "type": { "const": "ack" },
    "alarm_id": { "type": "string", "minLength": 1 },
    "operator": { "type": "string", "minLength": 1 },
    "sent_at": { "type": "number", "description": "unix seconds" }
  }
}
